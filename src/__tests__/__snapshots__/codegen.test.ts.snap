OverPath runner = new OverPath(OverPath.Drive.MECANUM,
        driveTrain.frontLeftMotor, driveTrain.frontRightMotor, driveTrain.backLeftMotor, driveTrain.backRightMotor, robot.imu,
        new OverPath.Constants(ticksPerRev, gearRatio, wheelDiameterIn, strafeMultiplier));
runner.log("BlueLeft30");
runner.setStartPose(-36.0, -63.0, 90.0);

runner.registerCommand("score", () -> {
});
runner.registerCommand("intakeOn", () -> {
});

runner
        .servo(clawServo, 0.1)
        .driveTo(-36.0, -36.0, 0.6)
            .marker(0.5, "intakeOn")
        .waitMs(1000)
        .turnTo(45.0, 0.5)
        .driveTo(-12.0, -36.0, 0.5)
